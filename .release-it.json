{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "commitMessage": "chore(release): ${version}",
    "tagName": "v${version}",
    "push": false
  },
  "hooks": {
    "after:bump": [
      "node sync-manifest.cjs",
      "pnpm run release:assets"
    ]
  },
  "github": {
    "release": true,
    "assets": [
      "dist/cindieh-chrome.zip",
      "dist/cindieh-firefox.xpi",
      "dist/cindieh-source.zip"
    ]
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "infile": "CHANGELOG.md",
      "preset": {
        "name": "conventionalcommits"
      }
    }
  }
}
