{
  "name": "better-coretax",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "description": "Better Coretax DJP Extension",
  "main": "build.js",
  "scripts": {
    "build": "node build.cjs",
    "build:chrome": "node build.cjs --browser=chrome",
    "build:firefox": "node build.cjs --browser=firefox",
    "watch": "node build.cjs --watch",
    "package:chrome": "node build.cjs --browser=chrome && node package.cjs --browser=chrome",
    "package:firefox": "node build.cjs --browser=firefox && node package.cjs --browser=firefox",
    "package": "pnpm run package:chrome && pnpm run package:firefox && pnpm run package:source",
    "package:source": "node package-source.cjs",
    "version": "node sync-manifest.cjs",
    "release": "standard-version",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "firefox",
    "extension",
    "coretax"
  ],
  "author": "Arisman",
  "license": "MIT",
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.3.0",
    "fast-check": "^4.7.0",
    "standard-version": "^9.5.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
