{
  "name": "cindieh",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "description": "Cindieh DJP Extension",
  "main": "build.js",
  "scripts": {
    "build": "pnpm run build:chrome && pnpm run build:firefox && node package.cjs --browser=chrome && node package.cjs --browser=firefox && node package-source.cjs",
    "build:chrome": "node build.cjs --browser=chrome",
    "build:firefox": "node build.cjs --browser=firefox",
    "watch": "node build.cjs --watch",
    "package:chrome": "node package.cjs --browser=chrome",
    "package:firefox": "node package.cjs --browser=firefox",
    "package": "node package.cjs --browser=chrome && node package.cjs --browser=firefox && node package-source.cjs",
    "release:assets": "node build.cjs --browser=chrome && node build.cjs --browser=firefox && node package.cjs --browser=chrome && node package.cjs --browser=firefox && node package-source.cjs",
    "package:source": "node package-source.cjs",
    "version": "node sync-manifest.cjs",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "lint": "eslint src/**/*.ts"
  },
  "keywords": [
    "firefox",
    "extension",
    "coretax"
  ],
  "author": "Arisman",
  "license": "MIT",
  "devDependencies": {
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.3.0",
    "fast-check": "^4.7.0",
    "release-it": "^21.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
