{
  "manifest_version": 3,
  "name": "Cindieh",
  "version": "2.1.0",
  "description": "Cindieh DJP Extension",
  "background": {
    "scripts": [
      "background/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://coretaxdjp.pajak.go.id/*"
      ],
      "js": [
        "content/main.js"
      ],
      "css": [
        "styles/injected.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/scraper.js"
      ],
      "matches": [
        "https://coretaxdjp.pajak.go.id/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "host_permissions": [
    "https://coretaxdjp.pajak.go.id/*"
  ],
  "permissions": [
    "activeTab",
    "storage"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "cindieh-ext-v2@arisman.me"
    }
  },
  "action": {
    "default_title": "Cindieh",
    "default_popup": "popup/popup.html"
  }
}
